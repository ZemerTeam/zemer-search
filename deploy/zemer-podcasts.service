[Unit]
Description=zemer-search podcast harvest (whitelist refetch -> onboard new + prune + refresh episodes -> corpus.db podcast_* tables)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# --- EDIT these for your deployment (match the API's WorkingDirectory + the app creds path) ---
WorkingDirectory=/opt/zemer-search
# The podcast whitelist is a Firestore read (podcastsWhitelist), same google-services.json creds as the
# artist whitelist. ZEMER_APP points at the zemer-app checkout that carries app/google-services.json.
Environment=ZEMER_APP=/opt/zemer-app
EnvironmentFile=-/opt/zemer-search/.env
# Fast-but-IP-safe pacing for the show-page + episode-continuation fetches (same profile as the sweep).
Environment=CONCURRENCY=5
Environment=MIN_INTERVAL_MS=200
# Stay out of the API's + refresh's way.
Nice=10
IOSchedulingClass=idle
# Shabbat handled IN CODE (skips 20 min before candle lighting until havdalah, Brooklyn zmanim).
ExecCondition=/usr/bin/env node harness/shabbat.mjs
#
# The pipeline mirrors scripts/maintain.sh (whitelist -> onboard -> prune -> refresh). Every step is
# '-'-prefixed so the four are INDEPENDENT: a failed whitelist refetch (keep the last known-good list) must
# not skip the refresh, and an onboard block must not skip prune's cleanup. The three DB-writing steps take
# the shared maintenance flock (`-n -E 0`: non-blocking, and if a full maintain.sh run holds the lock, skip
# THIS step cleanly with exit 0 — the next tick retries; nothing is lost). Per-step env is passed via
# `env VAR=VAL` so each podcasts.mjs invocation gets exactly the mode flag it needs.
#
# 1) Refetch the podcast whitelist (roster + version gate) -> data/podcasts-whitelist.json. Read-only
#    Firestore; on failure the last-good whitelist stays and the harvest steps below still run.
ExecStart=-/usr/bin/env node harness/podcasts-whitelist.mjs
# 2) Onboard shows not yet in the corpus (NEW=1 = new shows only).
ExecStart=-/usr/bin/flock -n -E 0 /tmp/zemer-maintain.lock /usr/bin/env NEW=1 node harvester/podcasts.mjs
# 3) Prune de-whitelisted shows + their episodes + orphan host channels (full pass).
ExecStart=-/usr/bin/flock -n -E 0 /tmp/zemer-maintain.lock /usr/bin/env PRUNE=1 node harvester/podcasts.mjs
# 4) Refresh: re-fetch each show page older than MAX_AGE_H so new episodes land (the network-heavy step, last).
ExecStart=-/usr/bin/flock -n -E 0 /tmp/zemer-maintain.lock /usr/bin/env MAX_AGE_H=12 node harvester/podcasts.mjs
TimeoutStartSec=30m
